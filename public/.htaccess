# ─── Block access to sensitive files ────────────────────────────────────────
<FilesMatch "(\.env|\.env\..*|composer\.json|composer\.lock|package\.json|pnpm-lock\.yaml|artisan|\.git)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do NOT rewrite backend API routes (leave for Laravel)
    RewriteCond %{REQUEST_URI} !^/backend

    # If request is not an existing file or directory, serve SPA
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Rewrite to Vue SPA entry
    RewriteRule ^ index.html [L]
</IfModule>
