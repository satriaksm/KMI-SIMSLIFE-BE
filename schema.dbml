  customer_note text [null]
  merchant_response varchar(30) [null]
  merchant_offered_price decimal(12,2) [null]
  merchant_note text [null]
  negotiated_price decimal(12,2) [null]
  negotiation_notes text [null]
  agreed_deadline date [null]
  proposed_date date [null]
  proposed_time time [null]
  proposed_notes text [null]
  offer_status varchar(30) [null]
  customer_accepted tinyint(1) [not null]
  customer_accepted_at timestamp [null]
  status varchar(30) [not null]
  responded_at timestamp [null]
  closed_at timestamp [null]
  order_id bigint unsigned [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table sessions {
  id varchar(191) [primary key, not null]
  user_id bigint unsigned [null]
  ip_address varchar(45) [null]
  user_agent text [null]
  payload longtext [not null]
  last_activity int [not null]
}

Table shipping_settings {
  id bigint unsigned [primary key, not null]
  base_cost decimal(10,2) [not null]
  cost_per_km decimal(10,2) [not null]
  status enum('active','inactive') [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table user_activity_metrics {
  id bigint unsigned [primary key, not null]
  user_id bigint unsigned [not null]
  posts_30d int unsigned [not null]
  comments_30d int unsigned [not null]
  orders_30d int unsigned [not null]
  total_activity_30d int unsigned [not null]
  reports_validated_30d int unsigned [not null]
  reports_total int unsigned [not null]
  last_login_at timestamp [null]
  last_login_days int unsigned [not null]
  activity_score decimal(8,2) [not null]
  pattern_spam_detected tinyint(1) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table user_activity_snapshots {
  id bigint unsigned [primary key, not null]
  user_id bigint unsigned [not null]
  period varchar(7) [not null]
  posts_count int unsigned [not null]
  comments_count int unsigned [not null]
  orders_count int unsigned [not null]
  total_activity int unsigned [not null]
  activity_score decimal(8,2) [not null]
  population_avg_activity int unsigned [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table user_login_events {
  id bigint unsigned [primary key, not null]
  user_id bigint unsigned [not null]
  logged_in_at timestamp [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table users {
  id bigint unsigned [primary key, not null]
  name varchar(191) [not null]
  email varchar(191) [not null]
  phone varchar(191) [null]
  profile_picture_path varchar(191) [null]
  nik varchar(191) [null]
  status enum('active','declining','watchlist','suspended','inactive') [not null]
  is_super_admin tinyint(1) [not null]
  email_verified_at timestamp [null]
  password varchar(191) [not null]
  remember_token varchar(100) [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table villages {
  id bigint unsigned [primary key, not null]
  district_id bigint unsigned [not null]
  name varchar(191) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table voucher_merchant_products {
  id bigint unsigned [primary key, not null]
  voucher_id bigint unsigned [not null]
  merchant_id bigint unsigned [not null]
  product_id bigint unsigned [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table voucher_merchants {
  id bigint unsigned [primary key, not null]
  voucher_id bigint unsigned [not null]
  merchant_id bigint unsigned [not null]
  status enum('active','inactive') [not null]
  voucher_type enum('percent','fixed') [null]
  discount_value decimal(15,2) [null]
  activated_at timestamp [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table voucher_usages {
  id bigint unsigned [primary key, not null]
  user_id bigint unsigned [not null]
  voucher_id bigint unsigned [not null]
  order_id bigint unsigned [null]
  discount_amount decimal(15,2) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table vouchers {
  id bigint unsigned [primary key, not null]
  merchant_id bigint unsigned [null]
  event_id bigint unsigned [null]
  voucher_name varchar(100) [not null]
  voucher_code varchar(100) [not null]
  voucher_status enum('active','inactive') [not null]
  is_secret tinyint(1) [not null]
  voucher_type enum('percent','fixed') [not null]
  voucher_description text [null]
  voucher_start_date date [not null]
  voucher_end_date date [not null]
  value decimal(15,2) [not null]
  max_discount_amount decimal(15,2) [null]
  min_purchase_amount decimal(15,2) [not null]
  usage_limit_per_user smallint unsigned [not null]
  usage_limit smallint unsigned [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

