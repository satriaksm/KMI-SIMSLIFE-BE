// ============================================================
// KMI-SIMSLIFE Database Schema (DBML)
// Generated from Laravel migrations
// ============================================================

Project KMI_SIMSLIFE {
  database_type: 'MySQL'
  Note: 'KMI SIMSLIFE - Backend Database Schema'
}

// ============================================================
// AUTH & USER MANAGEMENT
// ============================================================

Table users {
  id bigint [pk, increment]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  phone varchar(255) [null]
  profile_picture_path varchar(255) [null]
  nik varchar(255) [unique, null]
  status enum('active','declining','watchlist','suspended','inactive') [not null, default: 'active']
  email_verified_at timestamp [null]
  password varchar(255) [not null]
  remember_token varchar(100) [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    status [name: 'users_status_index']
  }
}

Table password_reset_tokens {
  email varchar(255) [pk]
  token varchar(255) [not null]
  created_at timestamp [null]
}

Table sessions {
  id varchar(255) [pk]
  user_id bigint [null]
  ip_address varchar(45) [null]
  user_agent text [null]
  payload longtext [not null]
  last_activity int [not null]

  indexes {
    user_id [name: 'sessions_user_id_index']
    last_activity [name: 'sessions_last_activity_index']
  }
}

// ============================================================
// REGIONAL / WILAYAH
// ============================================================

Table provinces {
  id bigint [pk, increment]
  name varchar(255) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table cities {
  id bigint [pk, increment]
  province_id bigint [not null]
  name varchar(255) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table districts {
  id bigint [pk, increment]
  city_id bigint [not null]
  name varchar(255) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table villages {
  id bigint [pk, increment]
  district_id bigint [not null]
  name varchar(255) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

// ============================================================
// ADDRESSES (Polymorphic)
// ============================================================

Table addresses {
  id bigint [pk, increment]
  addressable_type varchar(255) [not null]
  addressable_id bigint [not null]
  province_id bigint [not null]
  city_id bigint [not null]
  district_id bigint [not null]
  village_id bigint [not null]
  latitude decimal(10,7) [null]
  longitude decimal(10,7) [null]
  detail text [null]
  label varchar(50) [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (addressable_type, addressable_id) [name: 'addresses_addressable_type_addressable_id_index']
    (province_id, city_id, district_id, village_id) [name: 'addresses_region_index']
  }
}

// ============================================================
// SEGMENTATIONS & PAGUYUBANS
// ============================================================

Table segmentations {
  id bigint [pk, increment]
  name varchar(255) [not null]
  image_path varchar(255) [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table paguyubans {
  id bigint [pk, increment]
  name varchar(255) [not null]
  description varchar(255) [null]
  image_path varchar(255) [null]
  contact_info varchar(255) [null]
  is_active boolean [not null, default: true]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Referenced by merchants table'
}

// ============================================================
// MERCHANTS
// ============================================================

Table merchants {
  id bigint [pk, increment]
  user_id bigint [not null]
  paguyuban_id bigint [null]
  segmentation_id bigint [not null]
  name varchar(255) [not null]
  slug varchar(255) [not null, unique]
  description text [null]
  logo_path varchar(255) [null]
  cover_path varchar(255) [null]
  phone varchar(255) [null]
  operational_hours json [null]
  status enum('pending','approved','rejected') [not null, default: 'pending']
  rejection_reason text [null]
  reviewed_by bigint [null]
  response_at timestamp [null]
  NPWP varchar(255) [null]
  bank_name varchar(255) [null]
  bank_account_number varchar(255) [null]
  bank_account_name varchar(255) [null]
  midtrans_sub_account_id varchar(255) [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    slug [name: 'merchants_slug_index']
  }
}

// ============================================================
// CATEGORIES & CATEGORIZABLES (Polymorphic Many-to-Many)
// ============================================================

Table categories {
  id bigint [pk, increment]
  parent_id bigint [null]
  name varchar(255) [not null]
  slug varchar(255) [not null, unique]
  image_path varchar(255) [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    parent_id [name: 'categories_parent_id_index']
  }
}

Table categorizables {
  id bigint [pk, increment]
  category_id bigint [not null]
  categorizable_type varchar(255) [not null]
  categorizable_id bigint [not null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (categorizable_type, categorizable_id) [name: 'categorizables_categorizable_type_categorizable_id_index']
    (categorizable_id, categorizable_type, category_id) [unique, name: 'categorizables_unique']
    (categorizable_type, categorizable_id, category_id) [name: 'categorizables_morph_idx']
  }
}

// ============================================================
// IMAGES (Polymorphic)
// ============================================================

Table images {
  id bigint [pk, increment]
  imageable_type varchar(255) [not null]
  imageable_id bigint [not null]
  image_path varchar(255) [not null]
  display_order smallint [not null, default: 0]
  is_cover boolean [not null, default: false]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (imageable_type, imageable_id) [name: 'images_imageable_type_imageable_id_index']
    (imageable_type, imageable_id, is_cover) [name: 'images_cover_idx']
    (imageable_type, imageable_id, display_order) [name: 'images_order_idx']
  }
}

// ============================================================
// PRODUCTS & VARIANTS
// ============================================================

Table products {
  id bigint [pk, increment]
  merchant_id bigint [not null]
  name varchar(255) [not null]
  slug varchar(255) [not null, unique]
  description text [null]
  min_purchase int [not null, default: 1]
  status enum('draft','published','archived') [not null, default: 'draft']
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table product_variants {
  id bigint [pk, increment]
  product_id bigint [not null]
  stock int [not null, default: 0]
  sku varchar(255) [unique, null]
  price decimal(12,2) [not null, default: 0]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    product_id [name: 'product_variants_product_id_index']
  }
}

Table product_options {
  id bigint [pk, increment]
  product_id bigint [not null]
  option_name varchar(255) [not null]
  uses_image boolean [not null, default: false]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (product_id, option_name) [unique, name: 'product_options_product_id_option_name_unique']
  }
}

Table product_option_values {
  id bigint [pk, increment]
  product_option_id bigint [not null]
  option_value varchar(255) [not null]
  image_path varchar(255) [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (product_option_id, option_value) [unique, name: 'product_option_values_product_option_id_option_value_unique']
  }
}

Table product_variant_option_values {
  id bigint [pk, increment]
  product_variant_id bigint [not null]
  product_option_value_id bigint [not null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    product_variant_id [name: 'pvov_variant_idx']
    product_option_value_id [name: 'pvov_value_idx']
    (product_variant_id, product_option_value_id) [unique, name: 'pvov_unique']
  }
}

// ============================================================
// ADDONS
// ============================================================

Table addons {
  id bigint [pk, increment]
  merchant_id bigint [not null]
  addon_name varchar(100) [not null]
  created_at timestamp [null]
