}

// ============================================================
// CARTS
// ============================================================

Table carts {
  id bigint [pk, increment]
  user_id bigint [not null]
  merchant_id bigint [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table cart_items {
  id bigint [pk, increment]
  cart_id bigint [not null]
  itemable_type varchar(255) [not null]
  itemable_id bigint [not null]
  product_variant_id bigint [null, note: 'Snapshot pointer, bukan FK']
  itemable_name_snapshot varchar(255) [not null]
  product_variant_name_snapshot varchar(255) [null]
  image_snapshot_path varchar(255) [null]
  price_snapshot int [not null]
  quantity int [not null, default: 1]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (itemable_type, itemable_id) [name: 'cart_items_itemable_type_itemable_id_index']
    product_variant_id [name: 'cart_items_product_variant_id_index']
  }
}

Table cart_item_addons {
  id bigint [pk, increment]
  cart_item_id bigint [not null]
  addon_group_id bigint [not null, note: 'Snapshot pointer, bukan FK']
  addon_id bigint [not null, note: 'Snapshot pointer, bukan FK']
  addon_name_snapshot varchar(255) [null]
  addon_price_snapshot int [not null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    addon_group_id [name: 'cart_item_addons_addon_group_id_index']
    addon_id [name: 'cart_item_addons_addon_id_index']
  }
}

// ============================================================
// RELATIONSHIPS
// ============================================================

// -- Sessions
Ref: sessions.user_id > users.id

// -- Regional Hierarchy
Ref: cities.province_id > provinces.id [delete: cascade]
Ref: districts.city_id > cities.id [delete: cascade]
Ref: villages.district_id > districts.id [delete: cascade]

// -- Addresses → Regional
Ref: addresses.province_id > provinces.id [update: cascade, delete: restrict]
Ref: addresses.city_id > cities.id [update: cascade, delete: restrict]
Ref: addresses.district_id > districts.id [update: cascade, delete: restrict]
Ref: addresses.village_id > villages.id [update: cascade, delete: restrict]

// -- Merchants
Ref: merchants.user_id > users.id [update: cascade, delete: restrict]
Ref: merchants.paguyuban_id > paguyubans.id [update: cascade, delete: restrict]
Ref: merchants.segmentation_id > segmentations.id [update: cascade, delete: restrict]
Ref: merchants.reviewed_by > users.id [delete: set null]

// -- Categories (self-referencing)
Ref: categories.parent_id > categories.id [update: cascade, delete: set null]

// -- Categorizables (polymorphic pivot)
Ref: categorizables.category_id > categories.id [update: cascade, delete: cascade]

// -- Products
Ref: products.merchant_id > merchants.id [update: cascade, delete: restrict]

// -- Product Variants
Ref: product_variants.product_id > products.id [update: cascade, delete: cascade]

// -- Product Options
Ref: product_options.product_id > products.id [update: cascade, delete: cascade]

// -- Product Option Values
Ref: product_option_values.product_option_id > product_options.id [update: cascade, delete: cascade]

// -- Product Variant ↔ Option Values (pivot)
Ref: product_variant_option_values.product_variant_id > product_variants.id [update: cascade, delete: cascade]
Ref: product_variant_option_values.product_option_value_id > product_option_values.id [update: cascade, delete: cascade]

// -- Addons
Ref: addons.merchant_id > merchants.id [update: cascade, delete: cascade]

// -- Addon Groups
Ref: addon_groups.product_id > products.id [update: cascade, delete: cascade]

// -- Addon Group Options (pivot)
Ref: addon_group_options.addon_group_id > addon_groups.id [update: cascade, delete: cascade]
Ref: addon_group_options.addon_id > addons.id [update: cascade, delete: cascade]

// -- Events
Ref: events.created_by > users.id [delete: cascade]

// -- Vouchers
Ref: vouchers.merchant_id > merchants.id [delete: cascade]
Ref: vouchers.event_id > events.id [delete: cascade]

// -- Voucher Usages
Ref: voucher_usages.user_id > users.id [delete: cascade]
Ref: voucher_usages.voucher_id > vouchers.id [delete: cascade]
Ref: voucher_usages.order_id > orders.id [delete: set null]

// -- Orders
Ref: orders.address_id > addresses.id [delete: set null]
Ref: orders.user_id > users.id [delete: set null]
Ref: orders.merchant_id > merchants.id [delete: set null]
Ref: orders.voucher_id > vouchers.id [delete: set null]

// -- Product Order Items
Ref: product_order_items.order_id > orders.id [delete: set null]
Ref: product_order_items.product_id > products.id [delete: set null]
Ref: product_order_items.product_variant_id > product_variants.id [delete: set null]

// -- Product Order Item Addons
Ref: product_order_item_addons.product_order_item_id > product_order_items.id [delete: set null]
Ref: product_order_item_addons.addon_id > addons.id [delete: set null]

// -- Carts
Ref: carts.user_id > users.id [delete: cascade]
Ref: carts.merchant_id > merchants.id [delete: cascade]

// -- Cart Items (FK hanya ke carts; itemable & product_variant_id = snapshot pointer)
Ref: cart_items.cart_id > carts.id [delete: cascade]

// -- Cart Item Addons (FK hanya ke cart_items; addon_group_id & addon_id = snapshot pointer)
Ref: cart_item_addons.cart_item_id > cart_items.id [delete: cascade]
