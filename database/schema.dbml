  merchant_id bigint [null]
  voucher_id bigint [null]
  order_code varchar(255) [not null]
  subtotal decimal(12,2) [not null, default: 0]
  discount_total decimal(12,2) [not null, default: 0]
  gross_amount decimal(12,2) [not null, default: 0]
  delivery_fee_snapshot decimal(12,2) [not null, default: 0]
  status enum('pending','accepted','rejected','undelivered','paid','delivered','completed','cancelled','ready_to_pickup','unpicked') [not null, default: 'pending']
  accepted_at timestamp [null]
  rejected_at timestamp [null]
  paid_at timestamp [null]
  delivered_at timestamp [null]
  completed_at timestamp [null]
  cancelled_at timestamp [null]
  ready_to_pickup_at timestamp [null]
  unpicked_at timestamp [null]
  user_name_snapshot varchar(255) [not null]
  user_phone_snapshot varchar(255) [not null]
  address_detail_snapshot text [not null]
  province_name_snapshot varchar(255) [not null]
  city_name_snapshot varchar(255) [not null]
  district_name_snapshot varchar(255) [not null]
  village_name_snapshot varchar(255) [not null]
  latitude_snapshot decimal(10,7) [null]
  longitude_snapshot decimal(10,7) [null]
  created_at timestamp [null]
